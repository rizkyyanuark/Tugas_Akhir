# .env.example - local/deployment secret template
# Copy this file to .env and fill it with real values.
# Do not commit .env.

# Core infrastructure password used by local/prod Compose for Postgres, Neo4j,
# MinIO, and the initial Airflow admin user.
GLOBAL_PASSWORD=your_secure_password

# Application authentication
# Generate a persistent random value, for example:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_random_64_character_hex_secret

# Neo4j / AuraDB
# Local Docker uses compose defaults. Uncomment these only when the API should
# read the production Academic KG from Neo4j AuraDB.
# NEO4J_URI=neo4j+s://your-aura-instance.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_neo4j_or_aura_password
# NEO4J_DATABASE=neo4j
# KG_GRAPH_NAME=yunesa_academic_kg

# Zilliz Cloud / Milvus
# Local Docker uses compose defaults. For Zilliz Cloud, set MILVUS_URI to the
# cluster endpoint and MILVUS_TOKEN to your Zilliz API token or cluster token.
# MILVUS_URI=https://your-zilliz-cluster-endpoint
# MILVUS_TOKEN=your_zilliz_cloud_token
# MILVUS_DB_NAME=default

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Scraping / academic sources
SCIVAL_EMAIL=your_scival_email
SCIVAL_PASS=your_scival_password
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key

# BrightData
BD_USER_SERP=brd-customer-xxx-zone-serp_api
BD_PASS_SERP=your_brightdata_serp_password
BD_USER_UNLOCKER=brd-customer-xxx-zone-web_unlocker
BD_PASS_UNLOCKER=your_brightdata_unlocker_password

# AI / LLM providers
GROQ_API_KEY=your_groq_key
SILICONFLOW_API_KEY=your_siliconflow_key
OPENROUTER_API_KEY=your_openrouter_key
HF_TOKEN=your_huggingface_token
TAVILY_API_KEY=your_tavily_key

# Monitoring / notifications
OPIK_ENABLED=true
OPIK_API_KEY=your_opik_key
OPIK_WORKSPACE=your_opik_workspace
OPIK_PROJECT_NAME=yunesa-academic-graphrag
OPIK_ENVIRONMENT=development
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Airflow
AIRFLOW__CORE__FERNET_KEY=generate_with_cryptography_fernet
AIRFLOW_SECRET_KEY=generate_random_secret_key
AIRFLOW_JWT_SECRET=generate_random_jwt_secret

# AWS / deployment runtime
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
