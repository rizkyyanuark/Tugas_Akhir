# ══════════════════════════════════════════════════════════════
# .env.example — Template for New Developers
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# This file contains ONLY secrets. Non-secret config (ports,
# hostnames, model names) lives as defaults in:
#   - docker-compose.prod.yml  (infrastructure)
#   - backend/*/config.py      (application defaults)
#
# DO NOT commit .env to Git!
# ══════════════════════════════════════════════════════════════

# ── Master Password ──────────────────────────────────────────
# Single password used by: Postgres, Neo4j, Airflow Admin, Grafana
GLOBAL_PASSWORD=your_secure_password

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ── Scraping Credentials ─────────────────────────────────────
SCIVAL_EMAIL=your_email@example.com
SCIVAL_PASS=your_password
SERPAPI_KEY=your_serpapi_key

# ── BrightData Proxy ─────────────────────────────────────────
BD_USER_SERP=brd-customer-xxx-zone-serp_api
BD_PASS_SERP=your_password
BD_USER_UNLOCKER=brd-customer-xxx-zone-web_unlocker
BD_PASS_UNLOCKER=your_password
BRIGHTDATA_SERP_TOKEN=your_serp_api_token

# ── AI / LLM API Keys ───────────────────────────────────────
GROQ_API_KEY=your_groq_key
SILICONFLOW_API_KEY=your_siliconflow_key
OPENROUTER_API_KEY=your_openrouter_key
HF_TOKEN=your_huggingface_token
TAVILY_API_KEY=your_tavily_key

# ── Monitoring & Notifications ───────────────────────────────
OPIK_API_KEY=your_opik_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ── Airflow Security ─────────────────────────────────────────
AIRFLOW__CORE__FERNET_KEY=generate_with_python_-c_from_cryptography.fernet_import_Fernet;print(Fernet.generate_key().decode())
AIRFLOW_SECRET_KEY=generate_random_32_char_hex
AIRFLOW_JWT_SECRET=generate_random_string

# ── AWS (for CI/CD Pipeline) ─────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
