# .env.example - local/deployment secret template
# Copy this file to .env and fill it with real values.
# Do not commit .env.

# Core infrastructure password used by local/prod Compose for Postgres, Neo4j,
# MinIO, and the initial Airflow admin user.
GLOBAL_PASSWORD=your_secure_password

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Scraping / academic sources
SCIVAL_EMAIL=your_scival_email
SCIVAL_PASS=your_scival_password
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key

# BrightData
BD_USER_SERP=brd-customer-xxx-zone-serp_api
BD_PASS_SERP=your_brightdata_serp_password
BD_USER_UNLOCKER=brd-customer-xxx-zone-web_unlocker
BD_PASS_UNLOCKER=your_brightdata_unlocker_password

# AI / LLM providers
GROQ_API_KEY=your_groq_key
SILICONFLOW_API_KEY=your_siliconflow_key
OPENROUTER_API_KEY=your_openrouter_key
HF_TOKEN=your_huggingface_token
TAVILY_API_KEY=your_tavily_key

# Monitoring / notifications
OPIK_API_KEY=your_opik_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Airflow
AIRFLOW__CORE__FERNET_KEY=generate_with_cryptography_fernet
AIRFLOW_SECRET_KEY=generate_random_secret_key
AIRFLOW_JWT_SECRET=generate_random_jwt_secret

# AWS / deployment runtime
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
